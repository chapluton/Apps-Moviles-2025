<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiApp3.ViewModels"
             x:Class="MauiApp3.Views.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20">
            <Label Text="Hola," FontSize="16" TextColor="White"/>
            <Label Text="Alexis Henríquez" FontAttributes="Bold" FontSize="24" TextColor="White"/>

            <Frame BackgroundColor="White" CornerRadius="20" Padding="20" Margin="0,20,0,10" HasShadow="True">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <Label Text="Balance" Grid.ColumnSpan="2" TextColor="Gray"/>
                    <Label Text="{Binding Balance, StringFormat='${0:N2}'}"
                           Grid.Row="1" Grid.ColumnSpan="2"
                           FontAttributes="Bold" FontSize="20" TextColor="Black"/>
                    <Label Text="Ingresos" Grid.Row="2" Grid.Column="0" TextColor="Gray"/>
                    <Label Text="{Binding Ingresos, StringFormat='${0:N2}'}" Grid.Row="3" Grid.Column="0" TextColor="Green"/>
                    <Label Text="Egresos" Grid.Row="2" Grid.Column="1" TextColor="Gray"/>
                    <Label Text="{Binding Egresos, StringFormat='${0:N2}'}" Grid.Row="3" Grid.Column="1" TextColor="DarkRed"/>
                </Grid>
            </Frame>

            <Label Text="Transacciones" FontAttributes="Bold" FontSize="18" Margin="0,10,0,5" TextColor="Black"/>
            <CollectionView ItemsSource="{Binding Transacciones}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout>
                                <Label Text="{Binding Descripcion}" FontAttributes="Bold"/>
                                <Label Text="{Binding Fecha, StringFormat='{0:dd-MM-yyyy}'}" FontSize="12" TextColor="Gray"/>
                            </StackLayout>
                            <Label Text="{Binding Monto, StringFormat='${0:N2}'}"
                                   TextColor="{Binding Monto, Converter={StaticResource MontoColorConverter}}"
                                   HorizontalOptions="End"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="+" Command="{Binding AgregarTransaccionCommand}" 
                    HorizontalOptions="End" WidthRequest="60" HeightRequest="60" 
                    CornerRadius="30" BackgroundColor="Purple" FontSize="30"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>